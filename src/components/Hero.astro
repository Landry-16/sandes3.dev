---
import { Image } from "astro:assets";
import poster from "../assets/hero-poster.jpg";
import { profile as profileFr, profileEn } from "../data/profile";
import { langOf, t } from "../lib/i18n";

const profile = langOf(Astro.url) === "en" ? profileEn : profileFr;
const w = t(Astro.url).hero;
---

<section class="hero" data-hero aria-labelledby="hero-name">
  <Image class="poster" src={poster} alt={w.posterAlt} widths={[640, 1280, 1920]} sizes="100vw" loading="eager" fetchpriority="high" />
  <canvas class="scene" data-hero-canvas aria-hidden="true"></canvas>
  <div class="shade" aria-hidden="true"></div>

  <p class="samples" aria-hidden="true"><span data-hero-samples>{w.live}</span></p>

  <div class="content">
    <h1 class="name" id="hero-name"><span>{profile.firstName}</span> <em>{profile.lastName}</em></h1>
    <div class="intro">
      <p class="lede"><strong>{profile.role}.</strong> {profile.tagline}</p>
      <div class="actions">
        <a class="btn btn-light" href={profile.links.nacreQuote}>{w.quote}</a>
        <a class="btn btn-ghost" href="#projects">{w.projects}</a>
      </div>
      <p class="availability"><span class="dot" aria-hidden="true"></span>{profile.availability}</p>
    </div>
  </div>

  <p class="hint" aria-hidden="true">
    <span class="hint-live">{w.hintLive}</span>
    <span class="hint-static">{w.hintStatic}</span>
    <span class="hint-touch">{w.hintTouch}</span>
  </p>
</section>

<script>
  const root = document.querySelector<HTMLElement>("[data-hero]");
  const start = async (): Promise<void> => {
    root!.classList.remove("is-static", "is-waiting");
    const { startHero } = await import("../scripts/hero");
    startHero(root!);
  };
  if (root) {
    // With reduced motion the path tracer does not run: the rendered still stays.
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) root.classList.add("is-static");
    // On touch screens the tracer would hold the processor while the page loads: it waits for a touch.
    else if (matchMedia("(pointer: coarse)").matches) {
      root.classList.add("is-static", "is-waiting");
      root.addEventListener("pointerdown", start, { once: true });
    } else start();
  }
</script>

<style>
  .hero {
    position: relative;
    min-height: 640px;
    height: min(100svh, 1000px);
    overflow: hidden;
    background: var(--black);
    isolation: isolate;
    touch-action: pan-y;
  }
  .poster,
  .scene {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .poster {
    filter: grayscale(1) brightness(0.62) contrast(1.1);
    transition: opacity 1.2s var(--ease);
  }
  .scene {
    opacity: 0;
    filter: grayscale(1) brightness(0.62) contrast(1.1);
    transition: opacity 1.2s var(--ease);
    cursor: crosshair;
  }
  :global(.hero.is-live) .scene {
    opacity: 1;
  }
  :global(.hero.is-live) .poster {
    opacity: 0;
  }
  .shade {
    position: absolute;
    inset: 40% 0 0 0;
    background: linear-gradient(to bottom, transparent, rgba(0, 0, 0, 0.88));
    pointer-events: none;
  }

  .samples {
    position: absolute;
    top: calc(env(safe-area-inset-top, 0px) + 64px);
    right: var(--gutter);
    z-index: 2;
    font-size: 12px;
    color: var(--ink-mute);
    font-variant-numeric: tabular-nums;
  }

  .content {
    position: absolute;
    inset: auto 0 0 0;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 28px clamp(32px, 4vw, 64px);
    padding: 0 var(--gutter) clamp(56px, 8vh, 96px);
    pointer-events: none;
  }
  .content a {
    pointer-events: auto;
  }

  .name {
    display: flex;
    flex-direction: column;
    font-size: clamp(72px, 10.4vw, 196px);
    line-height: 0.86;
    letter-spacing: -0.025em;
    color: #ffffff;
    mix-blend-mode: difference;
    animation: rise 1.4s var(--ease) both;
  }
  .name em {
    font-style: italic;
  }

  .intro {
    display: grid;
    gap: 20px;
    width: 360px;
    max-width: 100%;
    animation: rise 1.4s 0.2s var(--ease) both;
  }
  .lede {
    font-size: 17px;
    line-height: 1.55;
  }
  .lede strong {
    font-weight: 500;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .availability {
    display: flex;
    align-items: baseline;
    gap: 10px;
    font-size: 12px;
    color: var(--ink-mute);
  }
  .dot {
    flex: none;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--ink);
    box-shadow: 0 0 10px 2px rgba(242, 242, 239, 0.7);
    transform: translateY(-1px);
  }

  .hint {
    position: absolute;
    left: var(--gutter);
    bottom: 20px;
    z-index: 2;
    font-size: 11px;
    color: var(--ink-mute);
  }
  .hint-static {
    display: none;
  }
  :global(.hero.is-static) .hint-live {
    display: none;
  }
  :global(.hero.is-static) .hint-static {
    display: inline;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(40px);
    }
  }

  @media (max-width: 1080px) {
    .content {
      grid-template-columns: minmax(0, 1fr);
    }
    .name {
      font-size: clamp(72px, 15vw, 196px);
    }
  }

  @media (max-width: 760px) {
    .hero {
      height: auto;
      min-height: 100svh;
    }
    .content {
      position: relative;
      grid-template-columns: minmax(0, 1fr);
      padding-top: 52svh;
    }
  }
  /* Touch screens: the still, until a touch starts the tracer. */
  .hint-touch,
  :global(.hero.is-waiting) .hint-static {
    display: none;
  }
  :global(.hero.is-waiting) .hint-touch {
    display: inline;
  }
</style>
