---
/**
 * Typographic cover for projects without screenshots (mostly private repositories):
 * the title set large in a dark plate, lit by a soft light pool whose position
 * is derived from the project slug so each cover differs.
 */
interface Props {
  title: string;
  slug: string;
  stack: string[];
}

const { title, slug, stack } = Astro.props;
let hash = 0;
for (const ch of slug) hash = (hash * 31 + ch.charCodeAt(0)) >>> 0;
const x = 20 + (hash % 60);
const y = 15 + ((hash >> 7) % 50);
---

<div class="cover" style={`--pool-x:${x}%;--pool-y:${y}%`} role="img" aria-label={`Aperçu de ${title}`}>
  <span class="cover-title" aria-hidden="true">{title}</span>
  <span class="cover-stack" aria-hidden="true">{stack.slice(0, 3).join(", ")}</span>
</div>

<style>
  .cover {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background:
      radial-gradient(circle at var(--pool-x) var(--pool-y), rgba(242, 242, 239, 0.2), rgba(242, 242, 239, 0.04) 38%, transparent 70%),
      #0f0f0e;
  }
  .cover-title {
    position: absolute;
    left: 16px;
    right: 16px;
    bottom: 0.12em;
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(44px, 5.4vw, 96px);
    overflow: hidden;
    text-overflow: clip;
    line-height: 1;
    white-space: nowrap;
    color: rgba(242, 242, 239, 0.86);
  }
  .cover-stack {
    position: absolute;
    top: 16px;
    left: 18px;
    font-size: 12px;
    color: var(--ink-mute);
  }
</style>
