---
import { Image } from "astro:assets";
import Cover from "./Cover.astro";
import { sourceLabel, type Project } from "../lib/projects";

interface Props {
  project: Project;
  size?: "large" | "medium" | "small";
}

const { project, size = "medium" } = Astro.props;
const { data } = project;
const widths = size === "large" ? [640, 960, 1280, 1600] : [480, 720, 960];
const sizes = size === "large" ? "(max-width: 900px) 100vw, 58vw" : "(max-width: 900px) 100vw, 40vw";
---

<article class:list={["card", `card-${size}`]} data-lit>
  <a class="card-link" href={`/projets/${project.id}`}>
    <div class="visual">
      {
        data.cover ? (
          <Image src={data.cover} alt={data.coverAlt ?? ""} widths={widths} sizes={sizes} loading="lazy" />
        ) : (
          <Cover title={data.title} slug={project.id} stack={data.stack} />
        )
      }
    </div>
    <div class="caption">
      <h3>{data.title}</h3>
      <p class="summary">{data.summary}</p>
      <p class="meta">
        <span>{data.stack.slice(0, 3).join(", ")}</span>
        <span class:list={["source", { public: Boolean(data.repo) }]}>
          {data.status === "En cours" ? "En cours, " : ""}{sourceLabel(project).toLowerCase()}
        </span>
      </p>
    </div>
  </a>
</article>

<style>
  .card {
    --lit: 0.35;
    min-width: 0;
  }
  .card-link {
    display: flex;
    flex-direction: column;
    gap: 18px;
    text-decoration: none;
  }
  .visual {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: #0f0f0e;
    box-shadow: var(--shadow-x, 14px) var(--shadow-y, 20px) 50px rgba(0, 0, 0, 0.9);
    transition: box-shadow 0.35s var(--ease);
  }
  .card-large .visual {
    aspect-ratio: 16 / 9.5;
  }
  .visual :global(img),
  .visual :global(.cover) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.06) brightness(calc(0.38 + var(--lit) * 0.66));
    transform: scale(1.001);
    transition: filter 0.3s var(--ease), transform 0.8s var(--ease);
  }
  .card-link:hover .visual :global(img),
  .card-link:hover .visual :global(.cover),
  .card-link:focus-visible .visual :global(img),
  .card-link:focus-visible .visual :global(.cover) {
    filter: grayscale(1) contrast(1.06) brightness(1.04);
    transform: scale(1.025);
  }
  .caption {
    display: grid;
    gap: 8px;
  }
  h3 {
    font-size: clamp(28px, 2.6vw, 40px);
  }
  .card-large h3 {
    font-size: clamp(34px, 3.4vw, 52px);
  }
  .summary {
    max-width: 52ch;
    color: var(--ink-mute);
    font-size: 15px;
    line-height: 1.55;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 4px 20px;
    font-size: 13px;
    color: var(--ink-mute);
  }
  .source.public {
    color: var(--ink);
  }
</style>
