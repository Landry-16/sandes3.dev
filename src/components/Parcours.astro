---
import { associative, education, experience, interests, skills, type CvEntry } from "../data/cv";
import { cvFile } from "../data/profile";

const groups: { label: string; entries: CvEntry[] }[] = [
  { label: "Expérience", entries: experience },
  { label: "Formation", entries: education },
  { label: "Engagements", entries: associative },
];
---

<section class="parcours" id="parcours" aria-labelledby="parcours-title">
  <div class="wrap">
    <header class="head">
      <h2 id="parcours-title">Parcours</h2>
      <div class="cv-actions">
        <a class="btn btn-dark" href={cvFile} download>Télécharger le CV (PDF)</a>
        <a class="cv-web" href="/cv">Voir le CV en ligne</a>
      </div>
    </header>

    {
      groups.map((group) => (
        <div class="group">
          <h3 class="group-label">{group.label}</h3>
          <ol class="rows">
            {group.entries.map((entry) => (
              <li class="row">
                <span class="period">{entry.period}</span>
                <span class="title">
                  {entry.title}
                  <span class="place">{entry.place}</span>
                </span>
                <span class="summary">
                  {entry.summary}
                  {entry.details && (
                    <ul>
                      {entry.details.map((d) => (
                        <li>{d}</li>
                      ))}
                    </ul>
                  )}
                </span>
              </li>
            ))}
          </ol>
        </div>
      ))
    }

    <dl class="skills">
      {
        skills.map((s) => (
          <div>
            <dt>{s.label}</dt>
            <dd>{s.value}</dd>
          </div>
        ))
      }
      <div>
        <dt>Ailleurs</dt>
        <dd>{interests}</dd>
      </div>
    </dl>
  </div>
</section>

<style>
  .parcours {
    padding-block: clamp(96px, 12vw, 160px);
    background: var(--paper);
    color: var(--paper-ink);
    color-scheme: light;
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px 48px;
    margin-bottom: clamp(48px, 6vw, 88px);
  }
  h2 {
    font-size: clamp(88px, 13vw, 200px);
  }
  .cv-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 24px;
  }
  .cv-web {
    font-size: 14px;
    font-weight: 500;
  }
  .group {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    margin-bottom: clamp(36px, 4vw, 56px);
  }
  .group-label {
    font-family: var(--sans);
    font-weight: 400;
    font-size: 13px;
    color: var(--paper-mute);
    margin-bottom: 12px;
  }
  .rows {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .row {
    display: grid;
    grid-template-columns: 170px minmax(0, 1.1fr) minmax(0, 1.4fr);
    gap: 12px 32px;
    padding-block: 22px;
    border-top: 1px solid var(--paper-line);
  }
  .period {
    font-size: 14px;
    color: var(--paper-mute);
    font-variant-numeric: tabular-nums;
  }
  .title {
    display: grid;
    gap: 4px;
    font-family: var(--serif);
    font-size: clamp(26px, 2.4vw, 36px);
    line-height: 1.05;
  }
  .place {
    font-family: var(--sans);
    font-size: 14px;
    color: var(--paper-mute);
  }
  .summary {
    font-size: 15px;
    line-height: 1.6;
    color: #2e2e2b;
    max-width: 62ch;
  }
  .summary ul {
    margin: 8px 0 0;
    padding-left: 18px;
  }
  .skills {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 28px 40px;
    margin: clamp(48px, 6vw, 80px) 0 0;
    padding-top: 32px;
    border-top: 1px solid var(--paper-line);
  }
  .skills dt {
    font-size: 12px;
    color: var(--paper-mute);
    margin-bottom: 6px;
  }
  .skills dd {
    margin: 0;
    font-size: 15px;
    line-height: 1.5;
  }
  @media (max-width: 860px) {
    .row {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
