---
import { Image } from "astro:assets";
import { homeTemplates, templateUrl } from "../data/templates";
import { profile, profileEn } from "../data/profile";
import { langOf, t, term } from "../lib/i18n";

const lang = langOf(Astro.url);
const w = t(Astro.url).demos;
const links = (lang === "en" ? profileEn : profile).links;

/** Three demo sites, all fictional shops: never shown as client work. */
const frames = homeTemplates.map((template) => ({
  href: templateUrl(template.slug),
  title: w.frameTitle(term(lang, template.trade)),
  caption: w.caption(template.shop),
  image: template.image,
  alt: w.alt(term(lang, template.trade), template.shop),
}));
---

<section class="demos" id="demos" aria-labelledby="demos-title">
  <div class="wrap head">
    <h2 id="demos-title">{w.title}</h2>
    <p>{w.lede}</p>
  </div>

  <div class="strip" data-strip>
    <ol class="frames">
      {
        frames.map((frame, i) => (
          <li class="frame" data-develop>
            <a href={frame.href} rel="noopener" target="_blank">
              <span class="exposure">
                <Image src={frame.image} alt={frame.alt} widths={[480, 880]} sizes="(max-width: 760px) 80vw, 440px" loading="lazy" />
              </span>
              <span class="number" aria-hidden="true">{`${14 + i}A`}</span>
              <span class="label">
                <span class="label-name">
                  {frame.title}
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                    <path d="M8 16L16 8M9 8h7v7" />
                  </svg>
                </span>
                <span class="label-kind">{frame.caption}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </div>
  <div class="wrap strip-controls">
    <button type="button" class="step" data-strip-step="-1" aria-label={w.prev}>
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M15 5l-7 7 7 7" /></svg>
    </button>
    <button type="button" class="step" data-strip-step="1" aria-label={w.next}>
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 5l7 7-7 7" /></svg>
    </button>
  </div>

  <div class="wrap freelance">
    <p>
      <strong>Freelance.</strong> {w.freelance}
    </p>
    <div class="freelance-actions">
      <a class="btn btn-light" href={links.nacreQuote}>{w.quote}</a>
      <a class="btn btn-ghost" href={links.nacre}>{w.nacre}</a>
    </div>
  </div>
</section>

<script>
  import { startStrip } from "../scripts/strip";

  startStrip();
</script>

<style>
  .demos {
    position: relative;
    padding-block: clamp(80px, 10vw, 140px);
    background: var(--black);
    overflow: hidden;
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px 48px;
    margin-bottom: clamp(48px, 6vw, 80px);
  }
  h2 {
    font-size: clamp(48px, 7vw, 112px);
  }
  .head p {
    max-width: 400px;
    color: var(--ink-mute);
    font-size: 15px;
    line-height: 1.6;
  }

  /* Film strip */
  .strip {
    position: relative;
    margin-inline: -4vw;
    padding: 44px calc(4vw + var(--gutter)) 56px;
    background-color: #121211;
    background-image:
      radial-gradient(circle at center, #000 0 6px, transparent 6.5px),
      radial-gradient(circle at center, #000 0 6px, transparent 6.5px);
    background-size: 40px 22px, 40px 22px;
    background-position: 0 6px, 0 calc(100% - 6px);
    background-repeat: repeat-x;
    transform: rotate(-1.6deg);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
  }
  .strip::-webkit-scrollbar {
    display: none;
  }
  .frames {
    display: flex;
    gap: 40px;
    width: max-content;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .frame {
    scroll-snap-align: start;
    scroll-margin-inline: calc(4vw + var(--gutter));
  }
  .frame a {
    display: grid;
    gap: 10px;
    width: clamp(260px, 32vw, 440px);
    color: var(--ink);
    text-decoration: none;
  }

  /* Each frame starts as a grey negative and develops into the real colours of the site. */
  .exposure {
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: #ecece8;
    filter: invert(1) grayscale(1) contrast(1.1);
    transition: filter 1.8s var(--ease) var(--develop-delay, 0ms);
  }
  .frame:global(.is-developed) .exposure {
    filter: invert(0) grayscale(0.15) contrast(1);
  }
  .frame a:hover .exposure,
  .frame a:focus-visible .exposure {
    filter: none;
    transition-delay: 0ms;
    transition-duration: 0.4s;
  }
  .exposure :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    transition: transform 0.6s var(--ease);
  }
  .frame a:hover .exposure :global(img) {
    transform: scale(1.02);
  }
  .number {
    font-size: 11px;
    font-weight: 500;
    color: #c9c9c4;
  }
  .label {
    display: grid;
    gap: 2px;
  }
  .label-name {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--serif);
    font-size: 26px;
    line-height: 1.1;
  }
  .label-name svg {
    opacity: 0;
    transform: translate(-4px, 4px);
    transition: opacity 0.3s var(--ease), transform 0.3s var(--ease);
  }
  .frame a:hover .label-name svg,
  .frame a:focus-visible .label-name svg {
    opacity: 1;
    transform: none;
  }
  .label-kind {
    font-size: 13px;
    color: var(--ink-mute);
  }

  .strip-controls {
    display: flex;
    justify-content: flex-end;
    gap: 10px;
    margin-top: 28px;
  }
  .step {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    color: var(--ink);
    background: transparent;
    border: 1px solid var(--line);
    border-radius: 50%;
    cursor: pointer;
    transition: background-color 0.25s var(--ease), opacity 0.25s var(--ease);
  }
  .step:hover {
    background: rgba(242, 242, 239, 0.1);
  }
  .step:disabled {
    opacity: 0.3;
    cursor: default;
  }

  /* Freelance */
  .freelance {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px 48px;
    margin-top: clamp(48px, 6vw, 80px);
    padding-top: 32px;
    border-top: 1px solid var(--line);
  }
  .freelance p {
    max-width: 52ch;
    color: var(--ink-mute);
    line-height: 1.6;
  }
  .freelance strong {
    color: var(--ink);
    font-weight: 500;
  }
  .freelance-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  @media (max-width: 620px) {
    .frame a {
      width: 78vw;
    }
  }
</style>
