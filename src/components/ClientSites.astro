---
import type { ClientSite } from "../lib/clients";

interface Props {
  sites: ClientSite[];
}

const { sites } = Astro.props;
---

<section class="clients" id="clients" aria-labelledby="clients-title">
  <div class="wrap head">
    <h2 id="clients-title">Sites clients</h2>
    <p>Les sites que je livre aux commerçants. Ils apparaissent ici automatiquement à chaque livraison.</p>
  </div>

  <div class="strip">
    <ol class="frames">
      {
        sites.map((site, i) => (
          <li class="frame" data-develop>
            <a href={site.url} rel="noopener" target="_blank">
              <span class="exposure">
                {site.image ? (
                  <img src={site.image} alt={`Aperçu du site de ${site.name}`} loading="lazy" decoding="async" />
                ) : (
                  <span class="mock" aria-hidden="true">
                    <span class="mock-title">{site.name}</span>
                    <span class="mock-line" />
                    <span class="mock-line short" />
                    <span class="mock-button" />
                  </span>
                )}
              </span>
              <span class="number" aria-hidden="true">{`${14 + i}A`}</span>
              <span class="label">
                <span class="label-name">{site.name}</span>
                <span class="label-kind">{[site.category, site.city].filter(Boolean).join(", ")}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .clients {
    position: relative;
    padding-block: clamp(80px, 10vw, 140px);
    background: var(--black);
    overflow: hidden;
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px 48px;
    margin-bottom: clamp(48px, 6vw, 80px);
  }
  h2 {
    font-size: clamp(64px, 9vw, 140px);
  }
  .head p {
    max-width: 360px;
    color: var(--ink-mute);
    font-size: 15px;
  }

  .strip {
    --hole: 18px;
    position: relative;
    margin-inline: -4vw;
    padding: 44px calc(4vw + var(--gutter)) 56px;
    background-color: #121211;
    background-image:
      radial-gradient(circle at center, #000 0 6px, transparent 6.5px),
      radial-gradient(circle at center, #000 0 6px, transparent 6.5px);
    background-size: 40px 22px, 40px 22px;
    background-position: 0 6px, 0 calc(100% - 6px);
    background-repeat: repeat-x;
    transform: rotate(-1.6deg);
    overflow-x: auto;
    scrollbar-width: none;
  }
  .frames {
    display: flex;
    gap: 40px;
    margin: 0;
    padding: 0;
    list-style: none;
    width: max-content;
  }
  .frame a {
    display: grid;
    gap: 10px;
    width: clamp(260px, 32vw, 440px);
    text-decoration: none;
  }
  .exposure {
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: #ecece8;
    filter: invert(1) grayscale(1) contrast(1.1);
    transition: filter 1.6s var(--ease) var(--develop-delay, 0ms);
  }
  .frame:global(.is-developed) .exposure,
  .frame a:hover .exposure,
  .frame a:focus-visible .exposure {
    filter: invert(0) grayscale(1) contrast(1.05);
  }
  .exposure img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .mock {
    display: grid;
    align-content: center;
    gap: 12px;
    height: 100%;
    padding: 8%;
    color: #141414;
  }
  .mock-title {
    font-family: var(--serif);
    font-size: clamp(26px, 2.6vw, 40px);
    line-height: 1;
  }
  .mock-line {
    height: 6px;
    width: 70%;
    background: #b9b9b4;
  }
  .mock-line.short {
    width: 45%;
  }
  .mock-button {
    width: 110px;
    height: 28px;
    border-radius: 14px;
    background: #141414;
  }
  .number {
    font-size: 11px;
    font-weight: 500;
    color: #c9c9c4;
  }
  .label {
    display: grid;
    gap: 2px;
  }
  .label-name {
    font-family: var(--serif);
    font-size: 26px;
    line-height: 1.1;
  }
  .label-kind {
    font-size: 13px;
    color: var(--ink-mute);
  }
</style>
