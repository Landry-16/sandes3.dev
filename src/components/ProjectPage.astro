---
import { Image } from "astro:assets";
/** The page of one project, in French (/projects/x) or English (/en/projects/x). */
import Page from "../layouts/Page.astro";
import Cover from "./Cover.astro";
import Gallery from "./Gallery.astro";
import { renderProject, type Project } from "../lib/projects";
import { langOf, t, term } from "../lib/i18n";

interface Props {
  project: Project;
  next: Project;
}

const { project, next } = Astro.props;
const { data } = project;
const lang = langOf(Astro.url);
const w = t(Astro.url).project;
const { Content } = await renderProject(project, lang);
const facts = [
  { label: w.year, value: String(data.year) },
  { label: w.kind, value: term(lang, data.kind) },
  { label: w.team, value: term(lang, data.team) },
  { label: w.status, value: term(lang, data.status) },
];
---

<Page title={`${data.title}, Sandes Savarimuthu`} description={data.summary}>
  <article class="wrap project">
    <header class="head">
      <p class="crumb"><a href="/projects">{w.crumb}</a></p>
      <h1>{data.title}</h1>
      <p class="summary">{data.summary}</p>
      <div class="links">
        {data.demo && <a class="btn btn-light" href={data.demo} rel="noopener" target="_blank">{data.demoLabel}</a>}
        {data.repo && <a class="btn btn-ghost" href={data.repo} rel="noopener" target="_blank">{w.source}</a>}
        {data.links.map((l) => <a class="btn btn-ghost" href={l.url} rel="noopener" target="_blank">{l.label}</a>)}
        {!data.repo && <span class="private">{w.private}</span>}
      </div>
    </header>

    {
      data.cover ? (
        <button
          type="button"
          class="hero-visual is-zoomable"
          data-lit
          data-zoom="cover"
          data-src={data.cover.src}
          data-alt={data.coverAlt ?? data.title}
          aria-label={w.zoom(data.coverAlt ?? data.title)}
        >
          <Image src={data.cover} alt={data.coverAlt ?? ""} widths={[800, 1280, 1800]} sizes="100vw" loading="eager" />
        </button>
      ) : (
        <div class="hero-visual" data-lit>
          <Cover title={data.title} slug={project.id} stack={data.stack} />
        </div>
      )
    }

    <div class="body">
      <dl class="facts">
        {
          facts.map((f) => (
            <div>
              <dt>{f.label}</dt>
              <dd>{f.value}</dd>
            </div>
          ))
        }
        <div>
          <dt>{w.stack}</dt>
          <dd>{data.stack.join(", ")}</dd>
        </div>
      </dl>
      <div class="prose">
        <Content />
      </div>
    </div>

    <Gallery items={data.gallery} label={w.images(data.title)} />

    <nav class="next" aria-label={w.next}>
      <span>{w.next}</span>
      <a href={`/projects/${next.id}`}>{next.data.title}</a>
    </nav>
  </article>
</Page>

<style>
  .head {
    display: grid;
    gap: 22px;
    max-width: 980px;
    margin-bottom: clamp(48px, 6vw, 80px);
  }
  .crumb {
    font-size: 13px;
    color: var(--ink-mute);
  }
  h1 {
    font-size: clamp(64px, 10vw, 160px);
  }
  .summary {
    max-width: 52ch;
    font-size: clamp(17px, 1.6vw, 21px);
    color: var(--ink-mute);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 16px;
  }
  .private {
    font-size: 13px;
    color: var(--ink-mute);
  }
  :global(.gallery) {
    margin-top: clamp(72px, 9vw, 120px);
  }
  .hero-visual {
    --lit: 0.6;
    display: block;
    width: 100%;
    padding: 0;
    border: 1px solid var(--line);
    overflow: hidden;
    background: #0f0f0e;
    box-shadow: var(--shadow-x, 14px) var(--shadow-y, 24px) 60px rgba(0, 0, 0, 0.9);
  }
  div.hero-visual {
    aspect-ratio: 16 / 8;
  }
  /* A cover keeps its own ratio: the frame shrinks around it instead of stretching it. */
  .is-zoomable {
    width: fit-content;
    max-width: 100%;
    margin-inline: auto;
    cursor: zoom-in;
  }
  .hero-visual :global(img),
  .hero-visual :global(.cover) {
    filter: grayscale(1) contrast(1.05) brightness(calc(0.5 + var(--lit) * 0.55));
    transition: filter 0.3s var(--ease);
  }
  .hero-visual :global(img) {
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: 78svh;
  }
  .hero-visual :global(.cover) {
    width: 100%;
    height: 100%;
  }
  .is-zoomable:hover :global(img),
  .is-zoomable:focus-visible :global(img) {
    filter: grayscale(0.1) contrast(1) brightness(1);
  }
  .body {
    display: grid;
    grid-template-columns: minmax(0, 300px) minmax(0, 1fr);
    gap: 40px clamp(32px, 6vw, 96px);
    margin-top: clamp(56px, 7vw, 96px);
  }
  .facts {
    display: grid;
    align-content: start;
    gap: 18px;
    margin: 0;
  }
  .facts dt {
    font-size: 12px;
    color: var(--ink-mute);
  }
  .facts dd {
    margin: 2px 0 0;
    font-size: 15px;
  }
  .prose {
    max-width: 66ch;
    font-size: 17px;
    line-height: 1.7;
  }
  .prose :global(h2) {
    font-size: clamp(30px, 3vw, 44px);
    margin: 48px 0 16px;
  }
  .prose :global(p + p) {
    margin-top: 1em;
  }
  .prose :global(ul) {
    padding-left: 20px;
  }
  .prose :global(li + li) {
    margin-top: 6px;
  }
  .prose :global(strong) {
    font-weight: 500;
  }
  .prose :global(code) {
    font-size: 0.9em;
    padding: 1px 5px;
    background: #1a1a19;
    border-radius: 3px;
  }
  .next {
    display: grid;
    gap: 6px;
    margin-top: clamp(96px, 12vw, 160px);
    padding-top: 28px;
    border-top: 1px solid var(--line);
  }
  .next span {
    font-size: 13px;
    color: var(--ink-mute);
  }
  .next a {
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(44px, 6vw, 96px);
    line-height: 1;
    text-decoration: none;
  }
  @media (max-width: 860px) {
    .body {
      grid-template-columns: minmax(0, 1fr);
    }
    div.hero-visual {
      aspect-ratio: 4 / 3;
    }
  }
</style>
