---
import ProjectCard from "./ProjectCard.astro";
import { getFeaturedProjects, getVisibleProjects } from "../lib/projects";

const featured = await getFeaturedProjects();
const total = (await getVisibleProjects()).length;
/** Alternating rhythm: one wide card and one narrow card per row, then a row of three. */
const pattern = ["large", "medium", "medium", "large", "small", "small", "small"] as const;
---

<section class="projects" id="projets" data-spot aria-labelledby="projets-title">
  <div class="wrap">
    <header class="head">
      <h2 id="projets-title">Projets</h2>
      <div class="aside">
        <p>Une sélection. Le code est ouvert quand le dépôt est public, les projets privés sont présentés en aperçu.</p>
        <a class="all" href="/projets">Tout voir ({total})</a>
      </div>
    </header>
    <div class="grid">
      {featured.map((project, i) => <ProjectCard project={project} size={pattern[i % pattern.length]} />)}
    </div>
  </div>
</section>

<style>
  .projects {
    position: relative;
    padding-block: clamp(96px, 14vw, 180px) clamp(80px, 10vw, 140px);
    background: var(--black);
  }
  .projects::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(640px circle at var(--spot-x, 30%) var(--spot-y, 20%), rgba(242, 242, 239, 0.075), transparent 70%);
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px 48px;
    margin-bottom: clamp(56px, 7vw, 96px);
  }
  h2 {
    font-size: clamp(88px, 13vw, 200px);
  }
  .aside {
    display: grid;
    gap: 14px;
    max-width: 340px;
    color: var(--ink-mute);
    font-size: 15px;
  }
  .all {
    justify-self: start;
    color: var(--ink);
    font-weight: 500;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(56px, 7vw, 104px) clamp(24px, 3vw, 48px);
    align-items: start;
  }
  .grid > :global(.card-large) {
    grid-column: span 7;
  }
  .grid > :global(.card-medium) {
    grid-column: span 5;
    margin-top: clamp(0px, 8vw, 120px);
  }
  .grid > :global(.card-small) {
    grid-column: span 4;
  }
  @media (max-width: 900px) {
    .grid > :global(.card) {
      grid-column: 1 / -1 !important;
      margin-top: 0 !important;
    }
  }
</style>
