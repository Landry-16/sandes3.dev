---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  items: { src: ImageMetadata; alt: string }[];
  label?: string;
}

const { items, label = "Images du projet" } = Astro.props;
/** Wide screenshots take a row of their own; squarer images pair up. */
const isWide = (image: ImageMetadata): boolean => image.width / image.height > 1.3;
---

<section class:list={["gallery", { "is-empty": items.length === 0 }]} aria-label={label}>
  {
    items.length > 0 && (
      <ul>
        {items.map((item, index) => (
          <li class:list={[isWide(item.src) ? "wide" : "narrow"]}>
            <figure>
              <button
                type="button"
                class="frame"
                data-zoom={index}
                data-src={item.src.src}
                data-alt={item.alt}
                aria-label={`Agrandir : ${item.alt}`}
              >
                <Image src={item.src} alt={item.alt} widths={[640, 960, 1440]} sizes="(max-width: 900px) 100vw, 60vw" loading="lazy" />
                <span class="zoom" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6">
                    <circle cx="11" cy="11" r="6.5" />
                    <path d="M16 16l5 5M11 8.5v5M8.5 11h5" />
                  </svg>
                </span>
              </button>
              <figcaption>{item.alt}</figcaption>
            </figure>
          </li>
        ))}
      </ul>
    )
  }

  <dialog class="lightbox" data-lightbox aria-label="Image agrandie">
    <button type="button" class="close" data-close aria-label="Fermer">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M6 6l12 12M18 6L6 18" /></svg>
    </button>
    <figure>
      <img data-lightbox-image src="" alt="" />
      <figcaption>
        <span data-lightbox-caption />
        <span class="count" data-lightbox-count />
      </figcaption>
    </figure>
    <button type="button" class="step prev" data-step="-1" aria-label="Image précédente">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M15 5l-7 7 7 7" /></svg>
    </button>
    <button type="button" class="step next" data-step="1" aria-label="Image suivante">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 5l7 7-7 7" /></svg>
    </button>
  </dialog>
</section>

<script>
  import { startLightbox } from "../scripts/lightbox";

  startLightbox();
</script>

<style>
  .gallery.is-empty {
    display: contents;
  }
  .gallery ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(40px, 5vw, 72px) clamp(24px, 3vw, 40px);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .wide {
    grid-column: 1 / -1;
    justify-self: center;
    width: min(100%, 1120px);
  }

  figure {
    margin: 0;
    display: grid;
    gap: 14px;
  }

  .frame {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: 1px solid var(--line);
    background: #0a0a0a;
    cursor: zoom-in;
    overflow: hidden;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.75);
  }
  /* The image sets the frame size, so it is never cropped nor stretched. */
  .frame :global(img) {
    width: 100%;
    height: auto;
    filter: grayscale(1) brightness(0.82) contrast(1.02);
    transition: filter 0.4s var(--ease), transform 0.5s var(--ease);
  }
  .frame:hover :global(img),
  .frame:focus-visible :global(img) {
    filter: grayscale(0.1) brightness(1) contrast(1);
    transform: scale(1.012);
  }

  .zoom {
    position: absolute;
    right: 12px;
    bottom: 12px;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    color: var(--black);
    background: var(--ink);
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.3s var(--ease), transform 0.3s var(--ease);
  }
  .frame:hover .zoom,
  .frame:focus-visible .zoom {
    opacity: 1;
    transform: none;
  }

  figcaption {
    font-size: 13px;
    line-height: 1.5;
    color: var(--ink-mute);
  }

  /* Lightbox */
  .lightbox {
    width: 100vw;
    max-width: 100vw;
    height: 100svh;
    max-height: 100svh;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgba(0, 0, 0, 0.94);
    color: var(--ink);
  }
  .lightbox::backdrop {
    background: rgba(0, 0, 0, 0.9);
  }
  .lightbox[open] {
    display: grid;
    place-items: center;
  }
  .lightbox figure {
    gap: 16px;
    justify-items: center;
    padding: clamp(48px, 7vh, 80px) clamp(56px, 8vw, 110px);
    max-width: 100%;
  }
  .lightbox img {
    max-width: min(100%, 1600px);
    max-height: 76svh;
    width: auto;
    height: auto;
    object-fit: contain;
    border: 1px solid var(--line);
  }
  .lightbox figcaption {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 20px;
    justify-content: center;
    text-align: center;
    max-width: 70ch;
  }
  .count {
    font-variant-numeric: tabular-nums;
  }

  .close,
  .step {
    position: absolute;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    color: var(--ink);
    background: rgba(242, 242, 239, 0.08);
    border: 1px solid var(--line);
    border-radius: 50%;
    cursor: pointer;
    transition: background-color 0.25s var(--ease);
  }
  .close:hover,
  .step:hover {
    background: rgba(242, 242, 239, 0.2);
  }
  .close {
    top: calc(env(safe-area-inset-top, 0px) + 20px);
    right: 20px;
  }
  .step {
    top: 50%;
    transform: translateY(-50%);
  }
  .prev {
    left: 14px;
  }
  .next {
    right: 14px;
  }
  .lightbox.is-single .step {
    display: none;
  }

  @media (max-width: 900px) {
    .gallery ul {
      grid-template-columns: minmax(0, 1fr);
    }
    .narrow,
    .wide {
      width: auto;
    }
    .zoom {
      opacity: 1;
      transform: none;
    }
    .lightbox figure {
      padding: 64px 16px;
    }
    .step {
      top: auto;
      bottom: 20px;
      transform: none;
    }
  }
</style>
