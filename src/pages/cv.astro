---
/**
 * The CV supplied as a PDF (public/cv-sandes-savarimuthu.pdf), shown as an image of its page so
 * it reads the same on every browser, phone included, with the PDF to download or open.
 * src/assets/cv/page-1.png is that page: render it again when the PDF changes
 * (pdftoppm -r 220 -png public/cv-sandes-savarimuthu.pdf src/assets/cv/page).
 */
import { Image } from "astro:assets";
import Page from "../layouts/Page.astro";
import sheet from "../assets/cv/page-1.png";
import { cvFile } from "../data/profile";
import { t } from "../lib/i18n";

const w = t(Astro.url).cv;
---

<Page title={w.title} description={w.description}>
  <div class="wrap cv">
    <header class="head">
      <h1>CV</h1>
      <div class="actions">
        <a class="btn btn-light" href={cvFile} download>{w.download}</a>
        <a class="btn btn-ghost" href={cvFile} target="_blank" rel="noopener">{w.open}</a>
      </div>
      {w.note && <p class="note">{w.note}</p>}
    </header>
    <a class="sheet" href={cvFile} target="_blank" rel="noopener" data-lit>
      <Image src={sheet} alt={w.alt} widths={[600, 900, 1300, 1818]} sizes="(max-width: 900px) 100vw, 820px" loading="eager" />
    </a>
  </div>
</Page>

<style>
  .cv {
    display: grid;
    gap: clamp(28px, 4vw, 48px);
    justify-items: center;
  }
  .head {
    display: grid;
    gap: 16px;
    justify-items: center;
    text-align: center;
  }
  h1 {
    margin: 0;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }
  .note {
    margin: 0;
    color: var(--ink-mute);
    font-size: 14px;
  }
  .sheet {
    display: block;
    width: min(100%, 820px);
    background: var(--paper);
    box-shadow:
      0 30px 80px rgba(0, 0, 0, 0.55),
      0 0 0 1px var(--line);
    transform: rotate(-0.6deg);
    transition: transform 400ms var(--ease);
  }
  .sheet:hover,
  .sheet:focus-visible {
    transform: rotate(0deg) translateY(-4px);
  }
  .sheet :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
  @media (prefers-reduced-motion: reduce) {
    .sheet,
    .sheet:hover {
      transform: none;
      transition: none;
    }
  }
</style>
