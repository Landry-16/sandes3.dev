---
import Page from "../layouts/Page.astro";
---

<Page title="Page introuvable, Sandes Savarimuthu" description="Cette page n'existe pas.">
  <div class="wrap lost">
    <h1>Rien n'est éclairé ici.</h1>
    <p>Cette page n'existe pas ou a été déplacée.</p>
    <a class="btn btn-light" href="/">Revenir à l'accueil</a>
  </div>
</Page>

<style>
  .lost {
    display: grid;
    justify-items: start;
    gap: 24px;
  }
  h1 {
    font-size: clamp(56px, 9vw, 140px);
    max-width: 12ch;
  }
  p {
    color: var(--ink-mute);
  }
</style>
