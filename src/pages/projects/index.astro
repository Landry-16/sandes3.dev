---
import Page from "../../layouts/Page.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { getVisibleProjects } from "../../lib/projects";

const projects = await getVisibleProjects();
const kinds = ["École", "Personnel", "Freelance"] as const;
const counts = Object.fromEntries(kinds.map((k) => [k, projects.filter((p) => p.data.kind === k).length]));
---

<Page title="Projets, Sandes Savarimuthu" description="Tous les projets de Sandes Savarimuthu : moteurs de rendu, réseau, applications web et outils.">
  <div class="wrap">
    <header class="head">
      <h1>Tous les projets</h1>
      <p>{projects.length} projets, d'Epitech, personnels ou réalisés pour mon activité freelance.</p>
    </header>

    <div class="filters" role="group" aria-label="Filtrer les projets">
      <button type="button" data-filter="all" aria-pressed="true">Tous ({projects.length})</button>
      {
        kinds
          .filter((k) => counts[k] > 0)
          .map((k) => (
            <button type="button" data-filter={k} aria-pressed="false">
              {k} ({counts[k]})
            </button>
          ))
      }
    </div>

    <ul class="list">
      {
        projects.map((project) => (
          <li data-kind={project.data.kind}>
            <ProjectCard project={project} size="small" />
          </li>
        ))
      }
    </ul>
  </div>
</Page>

<script>
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-filter]"));
  const items = Array.from(document.querySelectorAll<HTMLElement>("[data-kind]"));
  buttons.forEach((button) =>
    button.addEventListener("click", () => {
      const filter = button.dataset.filter;
      buttons.forEach((b) => b.setAttribute("aria-pressed", String(b === button)));
      items.forEach((item) => (item.hidden = filter !== "all" && item.dataset.kind !== filter));
    }),
  );
</script>

<style>
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px 48px;
    margin-bottom: 40px;
  }
  h1 {
    font-size: clamp(64px, 10vw, 160px);
  }
  .head p {
    max-width: 340px;
    color: var(--ink-mute);
    font-size: 15px;
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: clamp(48px, 6vw, 80px);
  }
  .filters button {
    font: 400 14px/1 var(--sans);
    color: var(--ink-mute);
    background: none;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 10px 16px;
    cursor: pointer;
  }
  .filters button[aria-pressed="true"] {
    color: var(--black);
    background: var(--ink);
    border-color: var(--ink);
  }
  .list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
    gap: clamp(48px, 5vw, 72px) clamp(24px, 3vw, 40px);
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
