---
import Base from "../layouts/Base.astro";
import SiteHeader from "../components/SiteHeader.astro";
import Hero from "../components/Hero.astro";
import FeaturedProjects from "../components/FeaturedProjects.astro";
import ClientSites from "../components/ClientSites.astro";
import Parcours from "../components/Parcours.astro";
import Contact from "../components/Contact.astro";
import { clientSites } from "../lib/clients";
import { profile } from "../data/profile";
---

<Base
  title={`${profile.name}, ${profile.role.toLowerCase()}`}
  description="Développeur logiciel et web à Paris, en troisième année à Epitech. Sites pour commerçants, logiciels en C++, Rust et TypeScript."
>
  <SiteHeader />
  <main>
    <Hero />
    <FeaturedProjects />
    <ClientSites sites={clientSites} />
    <Parcours />
    <Contact />
  </main>
</Base>

<script>
  import { startDeveloping, startLighting } from "../scripts/lighting";

  startLighting();
  startDeveloping();
</script>
