---
import Base from "../layouts/Base.astro";
import SiteHeader from "../components/SiteHeader.astro";
import Hero from "../components/Hero.astro";
import Demos from "../components/Demos.astro";
import FeaturedProjects from "../components/FeaturedProjects.astro";
import Parcours from "../components/Parcours.astro";
import Contact from "../components/Contact.astro";
import { profile as profileFr, profileEn } from "../data/profile";
import { langOf, t } from "../lib/i18n";

const profile = langOf(Astro.url) === "en" ? profileEn : profileFr;
const w = t(Astro.url).home;

const url = new URL(Astro.url.pathname, Astro.site).href;
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Person",
    name: profile.name,
    jobTitle: profile.role,
    url,
    email: `mailto:${profile.email}`,
    address: { "@type": "PostalAddress", addressLocality: profile.city, addressCountry: "FR" },
    sameAs: [profile.links.linkedin, profile.links.github],
  },
];
---

<Base
  title={w.title}
  description={w.description}
  schema={schema}
>
  <SiteHeader />
  <main>
    <Hero />
    <Demos />
    <FeaturedProjects />
    <Parcours />
    <Contact />
  </main>
</Base>

<script>
  import { startLighting, startDeveloping } from "../scripts/lighting";

  startLighting();
  startDeveloping();
</script>
