---
import { Image } from "astro:assets";
import { render } from "astro:content";
import Page from "../../layouts/Page.astro";
import Cover from "../../components/Cover.astro";
import { getVisibleProjects, type Project } from "../../lib/projects";

export async function getStaticPaths() {
  const projects = await getVisibleProjects();
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, next: projects[(i + 1) % projects.length] },
  }));
}

interface Props {
  project: Project;
  next: Project;
}

const { project, next } = Astro.props;
const { data } = project;
const { Content } = await render(project);
const facts = [
  { label: "Année", value: String(data.year) },
  { label: "Cadre", value: data.kind },
  { label: "Équipe", value: data.team },
  { label: "Statut", value: data.status },
];
---

<Page title={`${data.title}, Sandes Savarimuthu`} description={data.summary}>
  <article class="wrap project">
    <header class="head">
      <p class="crumb"><a href="/projets">Projets</a></p>
      <h1>{data.title}</h1>
      <p class="summary">{data.summary}</p>
      <div class="links">
        {data.demo && <a class="btn btn-light" href={data.demo} rel="noopener" target="_blank">{data.demoLabel}</a>}
        {data.repo && <a class="btn btn-ghost" href={data.repo} rel="noopener" target="_blank">Code source</a>}
        {data.links.map((l) => <a class="btn btn-ghost" href={l.url} rel="noopener" target="_blank">{l.label}</a>)}
        {!data.repo && <span class="private">Dépôt privé, aperçu seulement</span>}
      </div>
    </header>

    <div class="hero-visual" data-lit>
      {
        data.cover ? (
          <Image src={data.cover} alt={data.coverAlt ?? ""} widths={[800, 1280, 1800]} sizes="100vw" loading="eager" />
        ) : (
          <Cover title={data.title} slug={project.id} stack={data.stack} />
        )
      }
    </div>

    <div class="body">
      <dl class="facts">
        {
          facts.map((f) => (
            <div>
              <dt>{f.label}</dt>
              <dd>{f.value}</dd>
            </div>
          ))
        }
        <div>
          <dt>Technologies</dt>
          <dd>{data.stack.join(", ")}</dd>
        </div>
      </dl>
      <div class="prose">
        <Content />
      </div>
    </div>

    {
      data.gallery.length > 0 && (
        <ul class="gallery">
          {data.gallery.map((item) => (
            <li>
              <figure data-lit>
                <Image src={item.src} alt={item.alt} widths={[640, 960, 1400]} sizes="(max-width: 900px) 100vw, 50vw" loading="lazy" />
                <figcaption>{item.alt}</figcaption>
              </figure>
            </li>
          ))}
        </ul>
      )
    }

    <nav class="next" aria-label="Projet suivant">
      <span>Projet suivant</span>
      <a href={`/projets/${next.id}`}>{next.data.title}</a>
    </nav>
  </article>
</Page>

<style>
  .head {
    display: grid;
    gap: 22px;
    max-width: 980px;
    margin-bottom: clamp(48px, 6vw, 80px);
  }
  .crumb {
    font-size: 13px;
    color: var(--ink-mute);
  }
  h1 {
    font-size: clamp(64px, 10vw, 160px);
  }
  .summary {
    max-width: 52ch;
    font-size: clamp(17px, 1.6vw, 21px);
    color: var(--ink-mute);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 16px;
  }
  .private {
    font-size: 13px;
    color: var(--ink-mute);
  }
  .hero-visual {
    --lit: 0.6;
    aspect-ratio: 16 / 8;
    overflow: hidden;
    background: #0f0f0e;
    box-shadow: var(--shadow-x, 14px) var(--shadow-y, 24px) 60px rgba(0, 0, 0, 0.9);
  }
  .hero-visual :global(img),
  .hero-visual :global(.cover) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.05) brightness(calc(0.5 + var(--lit) * 0.55));
    transition: filter 0.3s var(--ease);
  }
  .body {
    display: grid;
    grid-template-columns: minmax(0, 300px) minmax(0, 1fr);
    gap: 40px clamp(32px, 6vw, 96px);
    margin-top: clamp(56px, 7vw, 96px);
  }
  .facts {
    display: grid;
    align-content: start;
    gap: 18px;
    margin: 0;
  }
  .facts dt {
    font-size: 12px;
    color: var(--ink-mute);
  }
  .facts dd {
    margin: 2px 0 0;
    font-size: 15px;
  }
  .prose {
    max-width: 66ch;
    font-size: 17px;
    line-height: 1.7;
  }
  .prose :global(h2) {
    font-size: clamp(30px, 3vw, 44px);
    margin: 48px 0 16px;
  }
  .prose :global(p + p) {
    margin-top: 1em;
  }
  .prose :global(ul) {
    padding-left: 20px;
  }
  .prose :global(li + li) {
    margin-top: 6px;
  }
  .prose :global(strong) {
    font-weight: 500;
  }
  .prose :global(code) {
    font-size: 0.9em;
    padding: 1px 5px;
    background: #1a1a19;
    border-radius: 3px;
  }
  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
    gap: 40px 32px;
    margin: clamp(72px, 9vw, 120px) 0 0;
    padding: 0;
    list-style: none;
  }
  figure {
    --lit: 0.5;
    margin: 0;
    display: grid;
    gap: 12px;
  }
  figure :global(img) {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    filter: grayscale(1) brightness(calc(0.5 + var(--lit) * 0.55));
    box-shadow: var(--shadow-x, 12px) var(--shadow-y, 18px) 48px rgba(0, 0, 0, 0.85);
  }
  figcaption {
    font-size: 13px;
    color: var(--ink-mute);
  }
  .next {
    display: grid;
    gap: 6px;
    margin-top: clamp(96px, 12vw, 160px);
    padding-top: 28px;
    border-top: 1px solid var(--line);
  }
  .next span {
    font-size: 13px;
    color: var(--ink-mute);
  }
  .next a {
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(44px, 6vw, 96px);
    line-height: 1;
    text-decoration: none;
  }
  @media (max-width: 860px) {
    .body {
      grid-template-columns: minmax(0, 1fr);
    }
    .hero-visual {
      aspect-ratio: 4 / 3;
    }
  }
</style>
