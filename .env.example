# Public URL of the deployed site, used for canonical links and the sitemap.
SITE_URL=https://sandess.dev

# Read-only GitHub token (fine-grained, "Contents: read" and "Metadata: read")
# with access to the pfinder-sites organization. Without it the client
# sites section is simply hidden.
PFINDER_GITHUB_TOKEN=
PFINDER_GITHUB_ORG=pfinder-sites
